{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniDrop",
  "version": "0.1.0",
  "identifier": "io.github.ernani1234.omnidrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OmniDrop",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "publisher": "Ernani",
    "copyright": "© 2026 Ernani. MIT License.",
    "homepage": "https://github.com/Ernani1234/Omnidrop",
    "shortDescription": "Convert files locally with drag and drop",
    "longDescription": "OmniDrop converts images, works with PDFs, converts audio and video (with FFmpeg) and creates or extracts archives. Everything runs on your computer; files are never uploaded.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
